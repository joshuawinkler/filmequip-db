{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "camera.schema.json",
  "title": "Camera",
  "type": "object",
  "required": ["id", "category", "manufacturer", "model", "type"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique, immutable ID. Format: manufacturer-model-slug, e.g. arri-alexa-mini-lf",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "enum": ["Digital Cameras", "Film Cameras"]
    },
    "manufacturer": { "type": "string" },
    "model": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["digital", "film"]
    },
    "mount": {
      "type": "string",
      "description": "e.g. PL, EF, LPL, PV"
    },
    "sensor": {
      "type": "object",
      "properties": {
        "size": { "type": "string", "description": "e.g. Super 35, Full Frame" },
        "resolution": { "type": "string", "description": "e.g. 4.6K, 6K" },
        "type": { "type": "string", "description": "e.g. CMOS" }
      }
    },
    "weight_kg": { "type": "number" },
    "release_year": { "type": "integer" },
    "notes": { "type": "string" },
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "Only link to freely licensed images (e.g. Wikimedia Commons), no uploads of your own into the repo"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Link to manufacturer page/datasheet for verification"
    }
  },
  "additionalProperties": false
}
